---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Use | ColitisHelpUSA.com"
  description="Terms of use for ColitisHelpUSA.com."
  canonical="/terms"
>
  <main class="max-w-[800px] mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-6" style="color: #0B2545">Terms of Use</h1>
    <p class="text-sm mb-6" style="color: #5C5C56">Last updated: 2025</p>
    <div class="space-y-6 text-base leading-relaxed" style="color: #5C5C56">
      <section>
        <h2 class="text-xl font-semibold mb-2" style="color: #0B2545">Acceptance of terms</h2>
        <p>By using ColitisHelpUSA.com, you agree to these terms of use. If you do not agree, please do not use this website.</p>
      </section>
      <section>
        <h2 class="text-xl font-semibold mb-2" style="color: #0B2545">Educational use only</h2>
        <p>This website provides educational information about ulcerative colitis and inflammatory bowel disease. It does not provide medical advice, diagnosis, or treatment. All content is for general informational purposes only and should not replace guidance from a licensed healthcare professional.</p>
      </section>
      <section>
        <h2 class="text-xl font-semibold mb-2" style="color: #0B2545">No medical provider relationship</h2>
        <p>Using this website does not create a patient-provider relationship between you and Colitis Help USA or any of its partners. We are not a medical provider, clinic, hospital, or telehealth service.</p>
      </section>
      <section>
        <h2 class="text-xl font-semibold mb-2" style="color: #0B2545">Limitation of liability</h2>
        <p>Colitis Help USA is not liable for any decisions made based on information provided on this website. Always consult a qualified healthcare professional before making any medical decisions.</p>
      </section>
      <section>
        <h2 class="text-xl font-semibold mb-2" style="color: #0B2545">Changes to terms</h2>
        <p>We may update these terms from time to time. Continued use of the website after changes constitutes acceptance of the updated terms.</p>
      </section>
    </div>
  </main>
</BaseLayout>
