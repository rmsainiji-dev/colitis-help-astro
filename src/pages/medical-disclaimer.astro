---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Medical Disclaimer | ColitisHelpUSA.com"
  description="Medical disclaimer for ColitisHelpUSA.com — educational website only, not medical advice."
  canonical="/medical-disclaimer"
>
  <main class="max-w-[800px] mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-6" style="color: #0B2545">Medical Disclaimer</h1>
    <div class="space-y-4 text-base leading-relaxed" style="color: #5C5C56">
      <p>Colitis Help USA is an educational website. The content on this site is provided for general informational purposes only. It is not intended to be, and should not be used as, a substitute for professional medical advice, diagnosis, or treatment from a licensed healthcare provider.</p>
      <p>Always seek the advice of your physician or another qualified health provider with any questions you may have regarding a medical condition. Never disregard professional medical advice or delay in seeking it because of content you have read on this website.</p>
      <p>If you think you may have a medical emergency, call your doctor, call 911, or go to the nearest emergency room immediately.</p>
    </div>
  </main>
</BaseLayout>
