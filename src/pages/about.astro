---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Colitis Help USA"
  description="Colitis Help USA is a patient information and care-navigation website for people living with ulcerative colitis and IBD in the United States."
  canonical="/about"
>
  <main class="max-w-[800px] mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-6" style="color: #0B2545">About Colitis Help USA</h1>
    <div class="space-y-4 text-base leading-relaxed" style="color: #5C5C56">
      <p>Colitis Help USA is a patient information and care-navigation website for people living with ulcerative colitis (UC), inflammatory bowel disease (IBD), and related conditions in the United States.</p>
      <p>We are not a medical provider, clinic, hospital, or telehealth service. Our goal is to help patients and caregivers understand UC symptoms, treatment options, diet, insurance, and clinical trial opportunities — and to connect them, where appropriate, with selected care-navigation resources.</p>
      <p>All content on this site is for educational purposes only. Please consult a licensed healthcare professional for medical advice about your condition.</p>
    </div>
    <div class="mt-8 pt-6" style="border-top: 1px solid #E8E8E4">
      <p class="text-sm" style="color: #5C5C56">
        Questions? See our <a href={import.meta.env.BASE_URL + "medical-disclaimer"} style="color: #0E6B8E; text-decoration: underline">Medical Disclaimer</a> and <a href={import.meta.env.BASE_URL + "partner-disclosure"} style="color: #0E6B8E; text-decoration: underline">Partner Disclosure</a>.
      </p>
    </div>
  </main>
</BaseLayout>
