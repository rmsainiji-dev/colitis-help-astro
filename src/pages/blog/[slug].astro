---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmergencyWarning from '../../components/layout/EmergencyWarning';
import GIQuestionsCard from '../../components/ui/GIQuestionsCard';
import RelatedArticles from '../../components/ui/RelatedArticles';
import CTAButton from '../../components/ui/CTAButton';
import QuickAnswerBox from '../../components/ui/QuickAnswerBox';
import ShareButtons from '../../components/ui/ShareButtons.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allArticles = await getCollection('articles');
const currentSlug = entry.data.slug ?? entry.id;

const relatedArticles = allArticles
  .filter((a) => (a.data.slug ?? a.id) !== currentSlug)
  .slice(0, 3)
  .map((a) => ({
    href: `/blog/${a.data.slug ?? a.id}`,
    title: a.data.title,
  }));

const emergencySlugs = [
  'blood-in-stool-ulcerative-colitis',
  'ulcerative-colitis-flare-up',
  'ulcerative-colitis-symptoms',
];
const showEmergencyWarning = emergencySlugs.includes(currentSlug);

const faqSchemas: Record<string, object> = {
  'crohns-vs-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Could my UC diagnosis actually be Crohn\'s disease?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sometimes a UC diagnosis is revised over time as the disease pattern becomes clearer. If you have concerns, discussing them with your gastroenterologist is appropriate. A second opinion from an IBD specialist can also be valuable.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does indeterminate colitis mean?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'In a minority of cases, IBD does not clearly fit either Crohn\'s or UC based on available evidence. This is called indeterminate colitis and may become clearer over time with additional testing or as the disease evolves.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does treatment change if I have Crohn\'s instead of UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, in some ways. Some medications are approved for one condition but not the other, and the treatment strategy for small bowel Crohn\'s differs significantly from UC management. Aminosalicylates work well for UC but are generally less effective for Crohn\'s.',
        },
      },
    ],
  },
  'ulcerative-colitis-remission': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Can ulcerative colitis go into remission permanently?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Some patients remain symptom-free for many years, but ulcerative colitis is generally considered a chronic condition with periods of remission and relapse. Consistent medication and monitoring give the best chance of long-term remission.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does deep remission mean in ulcerative colitis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Deep remission means both symptoms and colon inflammation are controlled — confirmed through colonoscopy and biopsy — rather than symptom relief alone. It is associated with better long-term outcomes and fewer hospitalizations.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is remission the same as being cured of ulcerative colitis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Remission means the disease is inactive or well-controlled, but the underlying condition remains and inflammation can return later. There is currently no permanent medical cure for ulcerative colitis.',
        },
      },
    ],
  },
  'jak-inhibitors-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a JAK inhibitor and how does it work for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'JAK inhibitors are small-molecule oral medications that block Janus kinase enzymes inside cells, reducing the inflammatory signals that drive ulcerative colitis. Unlike biologics which are injected or infused, JAK inhibitors are taken as a daily pill.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do JAK inhibitors differ from biologics for ulcerative colitis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'JAK inhibitors are oral pills that work inside cells, while biologics are injected or infused and block targets outside cells. JAK inhibitors generally act faster (days to weeks) compared to biologics (weeks to months). Both are used for moderate to severe UC.',
        },
      },
      {
        '@type': 'Question',
        name: 'Who is a candidate for a JAK inhibitor for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'JAK inhibitors are considered for patients with moderate to severe UC not controlled by mesalamine or steroids, UC that has not responded to biologics, or patients who prefer oral treatment over injections or infusions.',
        },
      },
    ],
  },
  'ulcerative-colitis-symptoms': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What are the first signs of ulcerative colitis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The most common early signs are frequent diarrhea, blood or mucus in the stool, and urgency to use the bathroom. Some people also experience cramping and abdominal pain, particularly on the left side.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I know if my symptoms are UC or something else?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'UC symptoms overlap with IBS, Crohn\'s disease, and infections. The key distinguishing features of UC are blood in the stool and inflammation limited to the colon. Only a colonoscopy can confirm a UC diagnosis.',
        },
      },
      {
        '@type': 'Question',
        name: 'When should I go to the ER for UC symptoms?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Go to the ER if you have severe abdominal pain, heavy rectal bleeding, a fever above 101°F, or signs of dehydration such as dizziness and inability to keep fluids down.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can UC symptoms come and go?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. UC follows a relapsing-remitting pattern — most patients have flare periods with active symptoms followed by remission periods where symptoms improve or disappear entirely.',
        },
      },
    ],
  },
  'ulcerative-colitis-flare-up': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How long does a UC flare usually last?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A UC flare can last anywhere from a few days to several weeks. Without treatment adjustment, some flares persist for months. Contacting your GI doctor early is the best way to shorten a flare.',
        },
      },
      {
        '@type': 'Question',
        name: 'What triggers a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Common triggers include stress, NSAIDs like ibuprofen, antibiotics, dietary changes, and infections. However, flares can also occur without any identifiable trigger.',
        },
      },
      {
        '@type': 'Question',
        name: 'Should I go to the hospital during a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Seek emergency care if you have more than 6 bloody stools per day, severe abdominal pain, fever, or signs of dehydration. Mild to moderate flares can usually be managed with your GI doctor by phone or urgent appointment.',
        },
      },
      {
        '@type': 'Question',
        name: 'What should I eat during a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'During a flare, most patients tolerate low-fiber, low-residue foods such as white rice, plain chicken, eggs, and cooked vegetables without skins. Avoid raw vegetables, high-fiber foods, dairy if lactose intolerant, and spicy foods.',
        },
      },
    ],
  },
  'blood-in-stool-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is blood in stool always a sign of UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Blood in stool can have many causes including hemorrhoids, anal fissures, polyps, or infections. However, blood in stool should always be evaluated by a doctor, especially if it is accompanied by diarrhea, urgency, or cramping.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much blood in stool is normal with UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'There is no safe amount of blood in stool. Any rectal bleeding with UC should be reported to your GI doctor. Heavy bleeding — soaking a pad or passing clots — is a medical emergency.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can UC bleeding stop on its own?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Minor bleeding may reduce during remission, but it does not reliably stop without proper treatment. Uncontrolled bleeding can lead to anemia and signals that your current treatment may need adjustment.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does UC blood in stool look like?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'UC bleeding typically appears as bright red blood mixed with or coating the stool, or blood and mucus with little formed stool during severe flares. Dark or tarry stools suggest bleeding higher in the GI tract and require immediate evaluation.',
        },
      },
    ],
  },
  'ulcerative-colitis-diet': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is there a specific diet that cures UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No diet has been proven to cure UC or induce remission. However, dietary choices can significantly affect symptom severity. A low-residue diet is often recommended during flares, while a more varied diet may be tolerated during remission.',
        },
      },
      {
        '@type': 'Question',
        name: 'What foods should I avoid with UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Common trigger foods include raw vegetables, high-fiber foods, spicy foods, alcohol, caffeine, and dairy products for those who are lactose intolerant. Triggers vary significantly between individuals.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can diet replace medication for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Diet can help manage symptoms and support gut health but cannot replace prescribed medication. Always continue your treatment plan as directed by your gastroenterologist.',
        },
      },
      {
        '@type': 'Question',
        name: 'Should I take supplements if I have UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Many UC patients are deficient in iron, vitamin D, vitamin B12, and folate due to malabsorption and inflammation. Ask your GI doctor to check your levels and recommend appropriate supplementation.',
        },
      },
    ],
  },
  'what-to-eat-during-uc-flare': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the best diet during a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A low-residue, low-fiber diet is generally best during a flare. Safe foods typically include white rice, plain chicken or fish, eggs, bananas, plain crackers, and well-cooked carrots. Avoid raw vegetables, whole grains, nuts, and seeds.',
        },
      },
      {
        '@type': 'Question',
        name: 'Should I stop eating during a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Stopping eating entirely is not recommended. Small, frequent meals of easily digestible foods are better than fasting. In severe cases, your doctor may recommend specific nutritional support.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is it safe to drink milk during a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Many UC patients have temporary lactose intolerance during flares. Try lactose-free dairy or avoid dairy altogether during active flares and reintroduce gradually during remission.',
        },
      },
      {
        '@type': 'Question',
        name: 'How long should I stay on a flare diet?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Continue a low-residue diet until your symptoms improve, then gradually reintroduce higher-fiber foods one at a time. Always follow your gastroenterologist\'s specific guidance.',
        },
      },
    ],
  },
  'ulcerative-colitis-treatment-options': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the first-line treatment for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'For mild to moderate UC, mesalamine (5-ASA) is typically the first treatment prescribed. It reduces inflammation in the colon lining and is available in oral and rectal forms.',
        },
      },
      {
        '@type': 'Question',
        name: 'When do doctors recommend biologics for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Biologics are typically recommended when mesalamine and corticosteroids have failed to control symptoms, or when a patient has moderate to severe UC that significantly affects daily life.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can UC be cured without surgery?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'There is no medication that permanently cures UC, but many patients achieve long-term remission with biologics or JAK inhibitors. Surgery (colectomy) is the only procedure that removes the disease entirely but comes with significant lifestyle changes.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I know if my UC treatment is working?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Your treatment is working if your symptoms improve — fewer bathroom trips, no blood, reduced pain — and if follow-up colonoscopies show reduced or no inflammation. Your doctor may also use blood and stool tests to measure inflammation markers.',
        },
      },
    ],
  },
  'mesalamine-not-working-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I know if mesalamine is not working for my UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Signs that mesalamine may not be working include ongoing blood in stool, persistent diarrhea of more than 4 times per day, continued cramping and urgency, and no improvement after 4 to 8 weeks of consistent use.',
        },
      },
      {
        '@type': 'Question',
        name: 'What comes after mesalamine for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'If mesalamine fails, the next steps typically include corticosteroids for short-term control, followed by immunomodulators, biologics, or JAK inhibitors for long-term maintenance depending on disease severity.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I take a higher dose of mesalamine if it is not working?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sometimes a dose adjustment helps, particularly if adherence has been inconsistent or if rectal formulations are added to oral therapy. This decision should always be made with your gastroenterologist — do not adjust doses on your own.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is it safe to stop mesalamine if it is not working?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Do not stop mesalamine without speaking to your doctor first. Even if symptoms persist, stopping suddenly can cause a rebound flare. Your doctor will help you transition safely to the next treatment.',
        },
      },
    ],
  },
  'biologics-for-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What are biologics for ulcerative colitis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Biologics are injectable or infused medications that target specific proteins in the immune system responsible for inflammation. Common biologics for UC include infliximab (Remicade), adalimumab (Humira), vedolizumab (Entyvio), and ustekinumab (Stelara).',
        },
      },
      {
        '@type': 'Question',
        name: 'How long do biologics take to work for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Some patients see improvement within 2 to 4 weeks, but full response can take up to 12 to 16 weeks. Your doctor will typically assess response after the induction phase before continuing maintenance dosing.',
        },
      },
      {
        '@type': 'Question',
        name: 'What are the main side effects of biologics for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Common side effects include increased risk of infection, injection site reactions, and fatigue. Rare but serious risks include reactivation of tuberculosis and certain cancers. Your doctor will screen you before starting and monitor you throughout treatment.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I stop taking biologics if I feel better?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Stopping biologics without medical guidance can cause a rapid return of symptoms or loss of response when restarting. Always discuss any changes to your treatment with your gastroenterologist.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are biologics covered by insurance for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Most insurance plans cover biologics for UC when other treatments have failed and medical necessity is documented. Prior authorization is usually required. Patient assistance programs are also available from most manufacturers.',
        },
      },
    ],
  },
  'prednisone-for-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How long do you take prednisone for a UC flare?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Most doctors prescribe prednisone for 3 to 12 weeks with a gradual taper. The dose is slowly reduced over time — never stopped suddenly — based on how your symptoms respond. The goal is to get off prednisone as quickly as safely possible.',
        },
      },
      {
        '@type': 'Question',
        name: 'What are the side effects of prednisone for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Short-term side effects include insomnia, mood changes, increased appetite, weight gain, fluid retention, and elevated blood sugar. Long-term use can cause bone loss, adrenal suppression, cataracts, high blood pressure, and increased diabetes risk. This is why prednisone is only used short-term.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is steroid dependence in UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Steroid dependence means your UC symptoms return every time you try to taper off prednisone. Steroid resistance means prednisone never adequately controlled your symptoms. Both are signs that a stronger long-term therapy such as a biologic or JAK inhibitor is needed.',
        },
      },
      {
        '@type': 'Question',
        name: 'What comes after prednisone for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Prednisone is never a long-term solution for UC. After prednisone, doctors typically move to immunomodulators like azathioprine, biologics like infliximab or vedolizumab, or JAK inhibitors like upadacitinib for sustained disease control.',
        },
      },
    ],
  },
};

const faqSchema = faqSchemas[currentSlug] ?? null;

type CtaBlock = { heading: string; body: string; button: string; href: string };
const ctaBlocks: Record<string, CtaBlock> = {
  'ulcerative-colitis-symptoms': {
    heading: 'Track your symptoms daily',
    body: 'Use our free printable UC Symptom Tracker to log pain, urgency, stool frequency, and foods — and bring it to your next GI appointment.',
    button: 'Get the Free Symptom Tracker',
    href: '/uc-symptom-tracker',
  },
  'ulcerative-colitis-flare-up': {
    heading: 'Surviving a UC flare?',
    body: 'Download our free UC Flare Survival Guide — warning signs, what to eat, when to call your doctor, and 25 questions to ask your GI.',
    button: 'Get the Free Flare Guide',
    href: '/free-uc-flare-guide',
  },
  'blood-in-stool-ulcerative-colitis': {
    heading: 'Not sure what to do next?',
    body: 'Download our free UC Flare Survival Guide — including when to call your doctor, emergency warning signs, and questions to bring to your appointment.',
    button: 'Get the Free Flare Guide',
    href: '/free-uc-flare-guide',
  },
  'ulcerative-colitis-diet': {
    heading: 'Confused about UC treatments?',
    body: 'Download our free UC Treatment Comparison Guide — a plain-English breakdown of every major UC medication from mesalamine to biologics.',
    button: 'Get the Free Treatment Guide',
    href: '/uc-treatment-comparison',
  },
  'what-to-eat-during-uc-flare': {
    heading: 'Need more help during a flare?',
    body: 'Download our free UC Flare Survival Guide — what to eat, what to avoid, warning signs, and 25 questions for your GI doctor.',
    button: 'Get the Free Flare Guide',
    href: '/free-uc-flare-guide',
  },
  'ulcerative-colitis-treatment-options': {
    heading: 'Compare every UC treatment side by side',
    body: 'Download our free UC Treatment Comparison Guide — mesalamine, steroids, immunomodulators, biologics, and JAK inhibitors explained in plain English.',
    button: 'Get the Free Comparison Guide',
    href: '/uc-treatment-comparison',
  },
  'biologics-for-ulcerative-colitis': {
    heading: 'Trying to understand your biologic options?',
    body: 'Download our free UC Treatment Comparison Guide — every major biologic and JAK inhibitor compared side by side in plain English.',
    button: 'Get the Free Treatment Guide',
    href: '/uc-treatment-comparison',
  },
  'jak-inhibitors-ulcerative-colitis': {
    heading: 'Weighing your UC treatment options?',
    body: 'Download our free UC Treatment Comparison Guide — biologics, JAK inhibitors, and every major UC medication compared side by side.',
    button: 'Get the Free Comparison Guide',
    href: '/uc-treatment-comparison',
  },
  'mesalamine-not-working-ulcerative-colitis': {
    heading: 'Mesalamine not working? Here are your options.',
    body: 'Download our free UC Treatment Comparison Guide to understand what comes next — immunomodulators, biologics, and JAK inhibitors explained in plain English.',
    button: 'Get the Free Treatment Guide',
    href: '/uc-treatment-comparison',
  },
  'crohns-vs-ulcerative-colitis': {
    heading: 'Preparing for your next GI appointment?',
    body: 'Download our free checklist of 25 questions to ask your GI doctor — covering diagnosis, treatment options, monitoring, and next steps.',
    button: 'Get the Free GI Checklist',
    href: '/gi-doctor-questions',
  },
  'ulcerative-colitis-remission': {
    heading: 'Questions about staying in remission?',
    body: 'Download our free checklist of 25 questions to ask your GI doctor about monitoring, treatment adjustments, and long-term remission strategies.',
    button: 'Get the Free GI Checklist',
    href: '/gi-doctor-questions',
  },
  'prednisone-for-ulcerative-colitis': {
    heading: 'Not sure what comes after prednisone?',
    body: 'Download our free UC Treatment Comparison Guide — every major UC medication explained in plain English, from mesalamine to biologics and JAK inhibitors.',
    button: 'Get the Free Treatment Guide',
    href: '/uc-treatment-comparison',
  },
};
const ctaBlock: CtaBlock | null = ctaBlocks[currentSlug] ?? null;

const publishDate = entry.data.publishDate ?? '2025-01-01';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: entry.data.title,
  url: `https://colitishelpusa.com/blog/${currentSlug}`,
  description: entry.data.description,
  datePublished: publishDate,
  dateModified: publishDate,
  author: {
    '@type': 'Organization',
    name: 'Colitis Help USA',
    url: 'https://colitishelpusa.com',
  },
  about: { '@type': 'MedicalCondition', name: 'Ulcerative Colitis' },
  audience: { '@type': 'Patient' },
};
---

<BaseLayout
  title={`${entry.data.title} | ColitisHelpUSA.com`}
  ogTitle={entry.data.title}
  description={entry.data.description}
  canonical={`/blog/${currentSlug}`}
  schema={schema}
  ogType="article"
>
  <Fragment slot="head">
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </Fragment>

  <main class="max-w-[800px] mx-auto px-4 sm:px-6 py-10 sm:py-12">

    <!-- Breadcrumb -->
    <nav class="text-xs mb-4" style="color: #5C5C56;" aria-label="Breadcrumb">
      <a href="/" style="color: #0E6B8E; text-decoration: underline;">Home</a>
      <span class="mx-1" aria-hidden="true">›</span>
      <a href="/blog" style="color: #0E6B8E; text-decoration: underline;">UC Articles</a>
      <span class="mx-1" aria-hidden="true">›</span>
      <span>{entry.data.title}</span>
    </nav>

    <!-- Published date -->
    <p class="text-xs mb-6 flex items-center gap-2" style="color: #9C9C96;">
      <span>By ColitisHelpUSA.com</span>
      <span aria-hidden="true">·</span>
      <time datetime={publishDate} style="color: #5C5C56;">
        {new Date(publishDate + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </p>

    {showEmergencyWarning && <EmergencyWarning />}

    <!-- QuickAnswerBox auto-injected from article description -->
    <QuickAnswerBox>
      {entry.data.description}
    </QuickAnswerBox>

    <!-- MDX content -->
    <div class="prose-article">
      <Content />
    </div>

    {ctaBlock && (
      <div class="my-8 p-5 sm:p-6 rounded-xl" style="background-color: #FAFAF8; border: 1px solid #E8E8E4;">
        <p class="text-base font-bold mb-2" style="color: #0B2545;">{ctaBlock.heading}</p>
        <p class="text-sm mb-4 leading-relaxed" style="color: #5C5C56;">{ctaBlock.body}</p>
        <a
          href={ctaBlock.href}
          class="inline-block px-6 py-3 rounded-lg text-sm font-semibold text-white"
          style="background-color: #C8902A;"
        >{ctaBlock.button} →</a>
      </div>
    )}

    <!-- Social share buttons -->
    <ShareButtons
      url={`https://colitishelpusa.com/blog/${currentSlug}`}
      title={entry.data.title}
    />

    <!-- GI questions card -->
    <GIQuestionsCard />

    <!-- Quiz CTA -->
    <div
      class="my-8 p-4 sm:p-6 rounded-xl text-center"
      style="background-color: #E4F5F7;"
    >
      <p class="text-sm mb-3" style="color: #0B2545;">
        Want to understand your UC care options? Take our free 8-question check.
      </p>
      <CTAButton href="/uc-care-options-check" variant="primary" size="lg">
        Check My UC Care Options
      </CTAButton>
      <p class="text-xs mt-2" style="color: #5C5C56;">
        Educational guidance only. Not medical advice.
      </p>
    </div>

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <RelatedArticles articles={relatedArticles} />
    )}
  </main>
</BaseLayout>
