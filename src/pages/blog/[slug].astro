---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmergencyWarning from '../../components/layout/EmergencyWarning';
import GIQuestionsCard from '../../components/ui/GIQuestionsCard';
import RelatedArticles from '../../components/ui/RelatedArticles';
import CTAButton from '../../components/ui/CTAButton';
import QuickAnswerBox from '../../components/ui/QuickAnswerBox';
import ShareButtons from '../../components/ui/ShareButtons.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allArticles = await getCollection('articles');
const currentSlug = entry.data.slug ?? entry.id;

const relatedArticles = allArticles
  .filter((a) => (a.data.slug ?? a.id) !== currentSlug)
  .slice(0, 3)
  .map((a) => ({
    href: `/blog/${a.data.slug ?? a.id}`,
    title: a.data.title,
  }));

const emergencySlugs = [
  'blood-in-stool-ulcerative-colitis',
  'ulcerative-colitis-flare-up',
  'ulcerative-colitis-symptoms',
];
const showEmergencyWarning = emergencySlugs.includes(currentSlug);

const faqSchemas: Record<string, object> = {
  'crohns-vs-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Could my UC diagnosis actually be Crohn\'s disease?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sometimes a UC diagnosis is revised over time as the disease pattern becomes clearer. If you have concerns, discussing them with your gastroenterologist is appropriate. A second opinion from an IBD specialist can also be valuable.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does indeterminate colitis mean?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'In a minority of cases, IBD does not clearly fit either Crohn\'s or UC based on available evidence. This is called indeterminate colitis and may become clearer over time with additional testing or as the disease evolves.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does treatment change if I have Crohn\'s instead of UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, in some ways. Some medications are approved for one condition but not the other, and the treatment strategy for small bowel Crohn\'s differs significantly from UC management. Aminosalicylates work well for UC but are generally less effective for Crohn\'s.',
        },
      },
    ],
  },
  'jak-inhibitors-ulcerative-colitis': {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a JAK inhibitor and how does it work for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'JAK inhibitors are small-molecule oral medications that block Janus kinase enzymes inside cells, reducing the inflammatory signals that drive ulcerative colitis. Unlike biologics which are injected or infused, JAK inhibitors are taken as a daily pill.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do JAK inhibitors differ from biologics for ulcerative colitis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'JAK inhibitors are oral pills that work inside cells, while biologics are injected or infused and block targets outside cells. JAK inhibitors generally act faster (days to weeks) compared to biologics (weeks to months). Both are used for moderate to severe UC.',
        },
      },
      {
        '@type': 'Question',
        name: 'Who is a candidate for a JAK inhibitor for UC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'JAK inhibitors are considered for patients with moderate to severe UC not controlled by mesalamine or steroids, UC that has not responded to biologics, or patients who prefer oral treatment over injections or infusions.',
        },
      },
    ],
  },
};

const faqSchema = faqSchemas[currentSlug] ?? null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: entry.data.title,
  url: `https://colitishelpusa.com/blog/${currentSlug}`,
  description: entry.data.description,
  about: { '@type': 'MedicalCondition', name: 'Ulcerative Colitis' },
  audience: { '@type': 'Patient' },
};
---

<BaseLayout
  title={`${entry.data.title} | ColitisHelpUSA.com`}
  ogTitle={entry.data.title}
  description={entry.data.description}
  canonical={`/blog/${currentSlug}`}
  schema={schema}
  ogType="article"
>
  <Fragment slot="head">
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </Fragment>

  <main class="max-w-[800px] mx-auto px-4 sm:px-6 py-10 sm:py-12">

    <!-- Breadcrumb -->
    <nav class="text-xs mb-6" style="color: #5C5C56;" aria-label="Breadcrumb">
      <a href="/" style="color: #0E6B8E; text-decoration: underline;">Home</a>
      <span class="mx-1" aria-hidden="true">›</span>
      <a href="/blog" style="color: #0E6B8E; text-decoration: underline;">UC Articles</a>
      <span class="mx-1" aria-hidden="true">›</span>
      <span>{entry.data.title}</span>
    </nav>

    {showEmergencyWarning && <EmergencyWarning />}

    <!-- QuickAnswerBox auto-injected from article description -->
    <QuickAnswerBox>
      {entry.data.description}
    </QuickAnswerBox>

    <!-- MDX content -->
    <div class="prose-article">
      <Content />
    </div>

    <!-- Social share buttons -->
    <ShareButtons
      url={`https://colitishelpusa.com/blog/${currentSlug}`}
      title={entry.data.title}
    />

    <!-- GI questions card -->
    <GIQuestionsCard />

    <!-- Quiz CTA -->
    <div
      class="my-8 p-4 sm:p-6 rounded-xl text-center"
      style="background-color: #E4F5F7;"
    >
      <p class="text-sm mb-3" style="color: #0B2545;">
        Want to understand your UC care options? Take our free 8-question check.
      </p>
      <CTAButton href="/uc-care-options-check" variant="primary" size="lg">
        Check My UC Care Options
      </CTAButton>
      <p class="text-xs mt-2" style="color: #5C5C56;">
        Educational guidance only. Not medical advice.
      </p>
    </div>

    <!-- Related articles -->
    {relatedArticles.length > 0 && (
      <RelatedArticles articles={relatedArticles} />
    )}
  </main>
</BaseLayout>
